class _Tile extends StatelessWidget {
  final String fileName;
  final VoidCallback onTap;
  final VoidCallback? onLongPress;
  final bool buildMode;
  final int? orderNumber;
  final bool played;
  final bool editMode;
  final int index;
  final void Function(int from, int to)? onMove;

  const _Tile({
    required this.fileName,
    required this.onTap,
    this.onLongPress,
    this.buildMode = false,
    this.orderNumber,
    this.played = false,
    this.editMode = false,
    this.index = 0,
    this.onMove,
  });

  @override
  Widget build(BuildContext context) {
    final nameWithoutExt = fileName.replaceAll(
      RegExp(r'\.(xml|mxl|musicxml|mei|png|jpg|jpeg|webp)$', caseSensitive: false),
      '',
    );

    final parts = nameWithoutExt.split('_');
    String number = '';
    String title = nameWithoutExt.replaceAll('_', ' ');

    if (parts.length > 1 && int.tryParse(parts.first) != null) {
      number = parts.first;
      title = parts.sublist(1).join(' ').replaceAll('_', ' ');
    }

    if (title.length > 20) {
      title = '${title.substring(0, 19)}…';
    }

    final selected = orderNumber != null;

    Color bgColor;
    if (selected && buildMode) {
      bgColor = const Color(0xFFD6AD23);
    } else if (played) {
      bgColor = const Color(0xFFF5E6C8);
    } else {
      bgColor = const Color(0xFF7BA7D9);
    }

    final inner = Material(
      color: bgColor,
      borderRadius: BorderRadius.circular(6),
      child: InkWell(
        onTap: onTap,
        onLongPress: editMode ? null : onLongPress,
        borderRadius: BorderRadius.circular(6),
        child: Padding(
          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
          child: Row(
            children: [
              if (buildMode && selected)
                Container(
                  width: 40,
                  height: 40,
                  alignment: Alignment.center,
                  decoration: const BoxDecoration(
                    color: Colors.black87,
                    shape: BoxShape.circle,
                  ),
                  child: Text(
                    '$orderNumber',
                    style: const TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                      color: Colors.white,
                    ),
                  ),
                )
              else if (number.isNotEmpty)
                Container(
                  width: 40,
                  height: 40,
                  alignment: Alignment.center,
                  decoration: const BoxDecoration(
                    color: Colors.white,
                    shape: BoxShape.circle,
                  ),
                  child: Text(
                    number,
                    style: const TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                      color: Colors.black,
                    ),
                  ),
                ),
              const SizedBox(width: 10),
              Expanded(
                child: Text(
                  title,
                  style: const TextStyle(
                    fontSize: 28,
                    fontWeight: FontWeight.w600,
                    color: Colors.black,
                  ),
                  maxLines: 1,
                  overflow: TextOverflow.clip,
                ),
              ),
            ],
          ),
        ),
      ),
    );

    if (!editMode || onMove == null) return inner;

    return DragTarget<int>(
      onWillAcceptWithDetails: (d) => d.data != index,
      onAcceptWithDetails: (d) => onMove!(d.data, index),
      builder: (context, candidate, rejected) {
        final highlight = candidate.isNotEmpty;
        return LongPressDraggable<int>(
          data: index,
          feedback: Material(
            color: Colors.transparent,
            child: Opacity(opacity: 0.7, child: inner),
          ),
          childWhenDragging: Opacity(opacity: 0.3, child: inner),
          child: highlight
              ? DecoratedBox(
                  decoration: BoxDecoration(
                    border: Border.all(color: Colors.white, width: 3),
                    borderRadius: BorderRadius.circular(6),
                  ),
                  child: inner,
                )
              : inner,
        );
      },
    );
  }
}
